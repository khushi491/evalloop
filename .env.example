# OpenAI-compatible API configuration.
# The key belongs to whichever provider OPENAI_BASE_URL points at.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash

# Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Ollama's OpenAI-compatible server. Any non-placeholder key is accepted; Ollama does not check it.
# JSON is parsed from the reply text. Leave OPENAI_JSON_MODE unset.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
# OPENAI_API_KEY=ollama
# EVAL_PROVIDER=ollama

# Set to response_format only for a provider that implements JSON mode.
# A 400 that mentions the field is retried once without it.
# OPENAI_JSON_MODE=

# Database
DATABASE_URL="file:./dev.db"

# Set to "true" to use built-in simulation (no API key needed for demo)
# Set to "false" or remove to use real LLM calls
USE_SIMULATION=true
